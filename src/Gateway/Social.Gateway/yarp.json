
{
  "ReverseProxy": {
    "Routes": {
      "auth-register": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/v1/auth/register",
          "Methods": ["POST"]
        }
      },
      "auth-login": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/v1/auth/login",
          "Methods": ["POST"]
        }
      },
      "auth-confirm-email": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/v1/auth/email/confirm",
          "Methods": ["POST"]
        }
      },

      "openapi-identity": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/openapi/identity/v1.json",
          "Methods": ["GET"]
        },
        "Transforms": [
          { "PathSet": "/openapi/v1.json" }
        ]
      },
      "openapi-posts": {
        "ClusterId": "posts",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/openapi/posts/v1.json",
          "Methods": ["GET"]
        },
        "Transforms": [
          { "PathSet": "/openapi/v1.json" }
        ]
      },
      "openapi-users": {
        "ClusterId": "users",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/openapi/users/v1.json",
          "Methods": ["GET"]
        },
        "Transforms": [
          { "PathSet": "/openapi/v1.json" }
        ]
      },
      "openapi-comments": {
        "ClusterId": "comments",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/openapi/comments/v1.json",
          "Methods": ["GET"]
        },
        "Transforms": [
          { "PathSet": "/openapi/v1.json" }
        ]
      },
      "openapi-media": {
        "ClusterId": "media",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/openapi/media/v1.json",
          "Methods": ["GET"]
        },
        "Transforms": [
          { "PathSet": "/openapi/v1.json" }
        ]
      },

      "user-profile": {
        "ClusterId": "users",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/v1/users/{userId}/profile",
          "Methods": ["GET"]
        }
      },
      "user-avatar": {
        "ClusterId": "users",
        "AuthorizationPolicy": "Authenticated",
        "Match": {
          "Path": "/api/v1/users/me/avatar",
          "Methods": ["PATCH"]
        }
      },

      "comments-create": {
        "ClusterId": "comments",
        "AuthorizationPolicy": "Authenticated",
        "Match": {
          "Path": "/api/v1/comments",
          "Methods": ["POST"]
        }
      },
      "comments-by-post": {
        "ClusterId": "comments",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/v1/comments/post/{postId}",
          "Methods": ["GET"]
        }
      },
      "comment-by-id": {
        "ClusterId": "comments",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/v1/comments/{commentId}",
          "Methods": ["GET"]
        }
      },

      "media-create": {
        "ClusterId": "media",
        "AuthorizationPolicy": "Authenticated",
        "Match": {
          "Path": "/api/v1/media",
          "Methods": ["POST"]
        }
      },

      "posts-create": {
        "ClusterId": "posts",
        "AuthorizationPolicy": "Authenticated",
        "Match": {
          "Path": "/api/v1/posts",
          "Methods": ["POST"]
        }
      },
      "post-by-id": {
        "ClusterId": "posts",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/v1/posts/{postId}",
          "Methods": ["GET"]
        }
      },
      "posts-list": {
        "ClusterId": "posts",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/v1/posts",
          "Methods": ["GET"]
        }
      }
    },

    "Clusters": {
      "identity": {
        "Destinations": {
          "destination1": {
            "Address": "http://social.identity:8080/"
          }
        }
      },
      "posts": {
        "Destinations": {
          "destination1": {
            "Address": "http://social.posts:8080/"
          }
        }
      },
      "users": {
        "Destinations": {
          "destination1": {
            "Address": "http://social.users:8080/"
          }
        }
      },
      "comments": {
        "Destinations": {
          "destination1": {
            "Address": "http://social.comments:8080/"
          }
        }
      },
      "media": {
        "Destinations": {
          "destination1": {
            "Address": "http://social.media:8080/"
          }
        }
      }
    }
  }
}
